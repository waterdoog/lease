{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.lease/hooks/lease-guard.mjs\" pre" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__lease__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.lease/hooks/lease-guard.mjs\" post" }]
      }
    ]
  }
}
